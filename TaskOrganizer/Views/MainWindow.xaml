<Window x:Class="TaskOrganizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TaskOrganizer.Views"
        Title="TaskOrganizer" Height="650" Width="1050"
        MinHeight="500" MinWidth="800"
        Icon="/Resources/AppIcon.ico">
    <Window.Resources>
        <Style x:Key="StyleOngletAvecIcone" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <TabControl x:Name="OngletsPrincipaux" Margin="16" SelectionChanged="OngletsPrincipaux_SelectionChanged">
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8FD;" Style="{StaticResource StyleOngletAvecIcone}" />
                    <TextBlock Text="Tâches" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Formulaire de création -->
        <GroupBox Grid.Row="0" Header="Nouvelle tâche" DataContext="{Binding CreateTacheViewModel}" Padding="8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                    <TextBlock Text="Titre *" />
                    <TextBox Text="{Binding Titre, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                    <TextBlock Text="Description" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                    <TextBlock Text="Échéance *" />
                    <DatePicker SelectedDate="{Binding DateEcheance, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="4">
                    <TextBlock Text="Priorité" />
                    <ComboBox ItemsSource="{Binding PrioritesDisponibles}" SelectedItem="{Binding Priorite}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" Margin="4">
                    <TextBlock Text="Statut" />
                    <ComboBox ItemsSource="{Binding StatutsDisponibles}" SelectedItem="{Binding Statut}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                    <TextBlock Text="Catégories (séparées par des virgules)" />
                    <TextBox Text="{Binding CategoriesTexte, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="4" VerticalAlignment="Bottom" Orientation="Horizontal">
                    <TextBlock Text="Rappels :" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox Content="1h avant" IsChecked="{Binding RappelUneHeureAvant}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <CheckBox Content="La veille" IsChecked="{Binding RappelLaVeille}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <CheckBox Content="1 semaine avant" IsChecked="{Binding RappelUneSemaineAvant}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="4">
                    <TextBlock Text="{Binding ErreurEnregistrement}" Foreground="Red" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="5" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="4">
                    <Button Padding="16,6" Command="{Binding EnregistrerCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource StyleOngletAvecIcone}" Margin="0,0,4,0" />
                            <TextBlock Text="Ajouter" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Recherche et tri -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Recherche :" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Width="220" Text="{Binding TexteRecherche, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Trier par :" VerticalAlignment="Center" Margin="16,0,4,0" />
            <ComboBox Width="140" ItemsSource="{Binding CriteresTriDisponibles}" SelectedItem="{Binding TriActuel}" />
        </StackPanel>

        <!-- Liste des tâches -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding TachesAffichees}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Titre" Binding="{Binding Titre}" Width="2*" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2.5*" />
                <DataGridTextColumn Header="Échéance" Binding="{Binding DateEcheance, StringFormat=dd/MM/yyyy}" Width="*" />
                <DataGridTextColumn Header="Priorité" Binding="{Binding Priorite}" Width="*" />
                <DataGridTemplateColumn Header="Statut" Width="1.2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                ItemsSource="{Binding DataContext.StatutsDisponibles, RelativeSource={RelativeSource AncestorType=Window}}"
                                SelectedItem="{Binding Statut, UpdateSourceTrigger=PropertyChanged}"
                                SelectionChanged="StatutComboBox_SelectionChanged" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Catégories" Binding="{Binding CategoriesAffichees}" Width="1.5*" />
                <DataGridTemplateColumn Header="Actions" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Margin="2" Padding="8,2" ToolTip="Modifier"
                                        Command="{Binding DataContext.ModifierCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource StyleOngletAvecIcone}" Margin="0" />
                                </Button>
                                <Button Margin="2" Padding="8,2" ToolTip="Supprimer"
                                        Command="{Binding DataContext.SupprimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource StyleOngletAvecIcone}" Margin="0" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE787;" Style="{StaticResource StyleOngletAvecIcone}" />
                    <TextBlock Text="Planning" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <views:PlanningView DataContext="{Binding PlanningViewModel}" Margin="0,8,0,0" />
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" Style="{StaticResource StyleOngletAvecIcone}" />
                    <TextBlock Text="Paramètres" VerticalAlignment="Center" />
                </StackPanel>
            </TabItem.Header>
            <views:ParametresView DataContext="{Binding ParametresViewModel}" Margin="0,8,0,0" />
        </TabItem>
    </TabControl>
</Window>
