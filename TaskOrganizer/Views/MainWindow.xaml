<Window x:Class="TaskOrganizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskOrganizer" Height="650" Width="950"
        MinHeight="500" MinWidth="700">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Formulaire de création -->
        <GroupBox Grid.Row="0" Header="Nouvelle tâche" DataContext="{Binding CreateTacheViewModel}" Padding="8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                    <TextBlock Text="Titre *" />
                    <TextBox Text="{Binding Titre, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                    <TextBlock Text="Description" />
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                    <TextBlock Text="Échéance *" />
                    <DatePicker SelectedDate="{Binding DateEcheance, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="4">
                    <TextBlock Text="Priorité" />
                    <ComboBox ItemsSource="{Binding PrioritesDisponibles}" SelectedItem="{Binding Priorite}" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="4" Margin="4">
                    <TextBlock Text="Statut" />
                    <ComboBox ItemsSource="{Binding StatutsDisponibles}" SelectedItem="{Binding Statut}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                    <TextBlock Text="Catégorie" />
                    <TextBox Text="{Binding Categorie, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="5" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="4">
                    <Button Content="Ajouter" Padding="16,6" Command="{Binding EnregistrerCommand}" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Liste des tâches -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Taches}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Titre" Binding="{Binding Titre}" Width="2*" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" />
                <DataGridTextColumn Header="Échéance" Binding="{Binding DateEcheance, StringFormat=dd/MM/yyyy}" Width="*" />
                <DataGridTextColumn Header="Priorité" Binding="{Binding Priorite}" Width="*" />
                <DataGridTextColumn Header="Statut" Binding="{Binding Statut}" Width="*" />
                <DataGridTextColumn Header="Catégorie" Binding="{Binding Categorie}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
